{
  "name": "lingxi-web",
  "version": "2.0.0",
  "private": true,
  "description": "灵犀系统前端 Monorepo（React 19 + Vite 7 + Ant Design 5，纯 SPA）",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter @lingxi/web dev",
    "build": "pnpm --filter @lingxi/web build",
    "preview": "pnpm --filter @lingxi/web preview",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "test:unit": "pnpm --filter @lingxi/web test:unit",
    "test:e2e": "playwright test",
    "gen:types": "bash openapi/gen-types.sh",
    "clean": "rm -rf node_modules **/node_modules **/dist"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
