<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  灵犀系统 Checkstyle 规则（技术规约2.0 §4.1.1：以《阿里巴巴 Java 开发手册（泰山版）》为基线）

  设计原则：只强制「机器可判定且与架构相关」的规则，风格类交给格式化工具，
  避免规则过严导致开发者习惯性 @SuppressWarnings，反而使规约失效。
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>

  <module name="NewlineAtEndOfFile"/>
  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>
  <module name="RegexpSingleline">
    <property name="format" value="\s+$"/>
    <property name="message" value="行尾不允许空白字符"/>
  </module>

  <!-- 禁止 System.out / printStackTrace（日志统一走 SLF4J，§4.11.1） -->
  <module name="RegexpSinglelineJava">
    <property name="format" value="System\.(out|err)\.print"/>
    <property name="message" value="禁止直接向标准输出打印；请使用 SLF4J 日志（技术规约2.0 §4.11.1）"/>
  </module>
  <module name="RegexpSinglelineJava">
    <property name="format" value="printStackTrace\(\)"/>
    <property name="message" value="禁止 printStackTrace；异常应统一抛 BizException 由全局处理器接管（§4.1.3）"/>
  </module>

  <!-- 禁止 new Thread / Executors 默认工厂（必须走 ThreadPoolManager，§4.1.5） -->
  <module name="RegexpSinglelineJava">
    <property name="format" value="new\s+Thread\s*\("/>
    <property name="message" value="禁止 new Thread；线程池统一由 ThreadPoolManager 创建（§4.1.5）"/>
  </module>
  <module name="RegexpSinglelineJava">
    <property name="format" value="Executors\.new"/>
    <property name="message" value="禁止 Executors 默认工厂；使用 ThreadPoolManager（§4.1.5）"/>
  </module>

  <!-- 金额禁用浮点（§3.3 D5） -->
  <module name="RegexpSinglelineJava">
    <property name="format" value="(amount|price|money|balance|fee)\w*\s*:\s*(float|double|Float|Double)"/>
    <property name="message" value="金额必须用最小货币单位整数存储，禁止浮点（§3.3 D5）"/>
  </module>

  <module name="TreeWalker">
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="IllegalImport">
      <property name="illegalPkgs" value="sun, com.sun, jdk.internal"/>
    </module>
    <!-- 空 catch 吞异常（§4.1.3） -->
    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="expected|ignored"/>
    </module>
    <module name="EqualsHashCode"/>
    <module name="MissingSwitchDefault"/>
    <module name="FallThrough"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="StringLiteralEquality"/>
    <module name="NeedBraces"/>
    <module name="MethodLength">
      <property name="max" value="80"/>
      <property name="countEmpty" value="false"/>
      <property name="tokens" value="METHOD_DEF"/>
    </module>
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="ConstantName"/>
    <module name="LocalVariableName"/>
    <module name="PackageName">
      <property name="format" value="^com\.lingxi(\.[a-z][a-z0-9]*)*$"/>
    </module>
    <module name="JavadocType">
      <property name="severity" value="info"/>
      <property name="scope" value="public"/>
    </module>
  </module>
</module>
