<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.lingxi</groupId>
    <artifactId>lingxi-server</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>yuanshu-starter-core</artifactId>
  <packaging>jar</packaging>
  <name>yuanshu-starter-core</name>
  <description>公共内核：统一响应体 · 错误码 · 全局异常 · TraceId · 租户上下文 · 审计字段自动填充</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <!--
      MyBatis-Plus：AuditMetaObjectHandler（审计字段自动填充）实现 MetaObjectHandler，
      该职责按《技术架构和组件选型方案2.0》§2.2 归属 starter-core。
      不能改为依赖 yuanshu-starter-mybatis —— 它已依赖本模块，反向依赖会成环。
      版本由 lingxi-dependencies BOM 锁定，此处不写版本号。
    -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
    </dependency>
  </dependencies>

</project>
