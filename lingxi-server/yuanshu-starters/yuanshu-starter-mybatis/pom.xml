<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.lingxi</groupId>
    <artifactId>lingxi-server</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>yuanshu-starter-mybatis</artifactId>
  <packaging>jar</packaging>
  <name>yuanshu-starter-mybatis</name>
  <description>数据访问：租户插件 · 分页 · 逻辑删除 · 乐观锁 · Flyway 迁移 · 数据权限拦截</description>

  <dependencies>
    <dependency>
      <groupId>com.lingxi</groupId>
      <artifactId>yuanshu-starter-core</artifactId>
    </dependency>
    <!-- MyBatis-Plus：Boot 4 专用 starter -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- DDL 只走 Flyway 版本化脚本（§4.4.3） -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- PostgreSQL 17：唯一 OLTP 权威源（§3.3 D1） -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <!-- 向量检索（知识 / 话术 / 画像 embedding），检索必须带 tenant_id 过滤（§4.4.5） -->
    <dependency>
      <groupId>com.pgvector</groupId>
      <artifactId>pgvector</artifactId>
    </dependency>
  </dependencies>

</project>
