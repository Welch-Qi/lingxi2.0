<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    灵犀（Lingxi）—— 营销服智能体集群聚合 POM
    定位：一底两翼之"一翼"。通人 —— 通客户、通市场、通内容、通服务（企业之外）。
    归口依据：《灵犀·开物·元枢三产品功能归口对照表-20260930》§3.1（208 项）
    硬约束：集群不得自建底座能力（架构规划 §4 约束2）——数据 / 语义 / 运行时 / 权限一律调用元枢 api 包。
    开物（Kaiwu）集群按归口表 §6.4 一期不建目录，二期在此平级新增 kaiwu/ 聚合。
  -->
  <parent>
    <groupId>com.lingxi</groupId>
    <artifactId>lingxi-server</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>lingxi-app</artifactId>
