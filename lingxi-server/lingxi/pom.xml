  <modules>
    <module>lingxi-workbench</module>
    <module>lingxi-customer</module>
    <module>lingxi-product</module>
    <module>lingxi-order</module>
    <module>lingxi-service</module>
    <module>lingxi-marketing</module>
    <module>lingxi-intel</module>
    <module>lingxi-analytics</module>
    <module>lingxi-agent</module>
    <module>lingxi-knowledge</module>
    <module>lingxi-configcenter</module>
  </modules>

</project>
