<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.lingxi</groupId>
    <artifactId>lingxi-server</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>lingxi-starter-observability</artifactId>
  <packaging>jar</packaging>
  <name>lingxi-starter-observability</name>
  <description>可观测：OTel 语义约定 · 结构化 JSON 日志 · Trace 透传 · Micrometer 指标</description>

  <dependencies>
    <dependency>
      <groupId>com.lingxi</groupId>
      <artifactId>lingxi-starter-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- 指标出口 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- 链路追踪：一条 Trace 贯穿 前端→网关→业务→Outbox→智能体→工具→外部 API/LLM（§4.11.2） -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
  </dependencies>

</project>
