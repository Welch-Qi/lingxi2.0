<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.lingxi</groupId>
    <artifactId>lingxi-server</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../..</relativePath>
  </parent>

  <artifactId>yuanshu-semantic</artifactId>
  <packaging>jar</packaging>
  <name>yuanshu-semantic</name>
  <description>元枢 制造行业语义管理（②类公共能力）：行业本体（产品/物料/工序/设备/能源）· 术语与编码 · 指标口径中心（DT-05）· 行业包托管（IP-06，内容由开物维护）· 知识/文档管理引擎框架（KC-01~06）· 语义服务</description>

  <dependencies>
    <!-- L0 公共能力（禁止自行实现，技术规约2.0 §4.8.1） -->
    <dependency>
      <groupId>com.lingxi</groupId>
      <artifactId>yuanshu-starter-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.lingxi</groupId>
      <artifactId>yuanshu-starter-observability</artifactId>
    </dependency>
    <dependency>
      <groupId>com.lingxi</groupId>
      <artifactId>yuanshu-starter-mybatis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.lingxi</groupId>
      <artifactId>yuanshu-starter-security</artifactId>
    </dependency>

    <!-- Web 与校验 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- 接口契约：OpenAPI 3.0 由代码注解产出，供文档库与前端类型生成（§4.3.2） -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
  </dependencies>
</project>
