# 灵犀系统前端环境变量（唯一权威清单，新增变量必须同步 src/vite-env.d.ts 声明）
#
# 铁律（技术规约2.0 §3.2 L4）：前端只允许 VITE_ 前缀的构建期变量；
# 密钥、数据库连接串等敏感配置一律不进入前端产物——前端能读到的东西等于公开。

# 后端网关基地址（开发环境默认 http://localhost:8080，由 vite proxy 转发 /api）
VITE_API_BASE_URL=http://localhost:8080

# 统一身份平台（Keycloak Realm URL）。留空时登录页会明确提示服务不可用，不会白屏。
VITE_OIDC_AUTHORITY=

# OIDC 客户端 ID（公共客户端 + PKCE，前端不持有 secret）
VITE_OIDC_CLIENT_ID=lingxi-web

# 环境标识，用于底部状态栏与排障
VITE_APP_ENV=dev

# 静态骨架预览开关（仅 dev 生效）。
# true  = 跳过 OIDC，使用占位会话（租户/权限为演示数据），用于后端就绪前自检页面；
# false = 走真实 Keycloak 登录流程。
# 后端与 Keycloak 接好后必须改回 false，并确认该变量未进入生产环境。
VITE_LX_STATIC_PREVIEW=true
