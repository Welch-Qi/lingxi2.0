################################################################################
# 灵犀系统环境变量清单（.env.example，入版本库）
#
# 使用方式：复制为 .env 后填入真实值；.env 已 gitignore，禁止入库（§3.5 F2/F4）
#   cp .env.example .env && vi .env
#
# 铁律：真实口令与密钥只允许出现在 .env / 云 KMS / OpenBao；
#       禁止写入 config/*.yml、禁止写入代码、禁止打印到日志（§4.9.3）
################################################################################

# ---------------------------------------------------------------- 运行环境
LX_ENV=dev
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LX_WORKER_ID=1
LX_DATACENTER_ID=1
LX_LOG_LEVEL=INFO
LX_TRACE_SAMPLING=1.0

# ---------------------------------------------------------------- SSH 隧道（云端地址唯一出现处）
# 说明：应用永远只连 127.0.0.1:13306 / 16379；此处配置的是隧道对端
LX_SSH_HOST=
LX_SSH_PORT=22
LX_SSH_USER=
LX_SSH_KEY_FILE=
LX_DB_TUNNEL_PORT=13306
LX_CACHE_TUNNEL_PORT=16379
LX_CLOUD_DB_HOST=
LX_CLOUD_DB_PORT=5432
LX_CLOUD_CACHE_HOST=
LX_CLOUD_CACHE_PORT=6379

# ---------------------------------------------------------------- PostgreSQL 17
LX_DB_NAME=lingxi
LX_DB_USER=
LX_DB_PASSWORD=
LX_DB_POOL_MAX=20
LX_DB_POOL_MIN=4

# ---------------------------------------------------------------- Valkey 9
LX_CACHE_PASSWORD=
LX_CACHE_DB=0

# ---------------------------------------------------------------- 认证（Keycloak 26）
# Realm 天然对应租户；issuer 形如 https://<keycloak-host>/realms/<realm>
LX_OIDC_ISSUER_URI=
LX_OIDC_JWK_SET_URI=
LX_OIDC_SPA_CLIENT_ID=lingxi-web
LX_OIDC_SERVICE_CLIENT_ID=lingxi-server
LX_OIDC_AGENT_CLIENT_ID=lingxi-agent

# ---------------------------------------------------------------- 对象存储（S3 兼容）
LX_STORAGE_TYPE=s3
LX_STORAGE_BUCKET=
LX_STORAGE_REGION=cn-east-1
LX_STORAGE_ENDPOINT=
LX_STORAGE_ACCESS_KEY=
LX_STORAGE_SECRET_KEY=

# ---------------------------------------------------------------- 模型网关（唯一模型名注入处）
# 说明：具体模型名只通过这里进入 config/model.yml；业务代码禁止出现模型名
LX_MODEL_BASE_URL=
LX_MODEL_API_KEY=
LX_MODEL_PRIMARY=
LX_MODEL_SECONDARY=
LX_MODEL_LIGHT=
LX_MODEL_EMBEDDING=
LX_MODEL_MONTHLY_TOKEN_QUOTA=2000000

# ---------------------------------------------------------------- 通知与外部通道（凭证加密托管，永不出网关）
LX_NOTIFY_CHANNELS=inbox,email
LX_NOTIFY_EMAIL_FROM=
LX_SMTP_HOST=
LX_SMTP_PORT=465
LX_SMTP_USER=
LX_SMTP_PASSWORD=
LX_WHATSAPP_TOKEN=
LX_WHATSAPP_PHONE_ID=
LX_SOCIAL_CREDENTIAL_KEY=        # 渠道凭证加密密钥（云 KMS 亦可）

# ---------------------------------------------------------------- 应用与前端
LX_APP_BASE_URL=http://localhost:8080
LX_CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=lingxi-web

# ---------------------------------------------------------------- 外部数据源（L1 数据底座）
LX_CUSTOMS_API_BASE=
LX_CUSTOMS_API_KEY=
LX_GLOBAL_DB_API_BASE=
LX_GLOBAL_DB_API_KEY=

# ---------------------------------------------------------------- AI Coding 流水线（用于 scripts/dispatch-task.sh）
CURSOR_API_KEY=
QODER_PAT=
LX_DISPATCH_TOOL=qoder
